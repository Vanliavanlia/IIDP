{
  "views": {
    "inspection_record_grid": {
      "mode": "primary",
      "name": "检验记录-表格",
      "model": "inspection_record",
      "type": "grid",
      "body": {
        "type": "grid",
        "buttons": [
          {
            "name": "详情",
            "action": "preview",
            "auth": "read"
          },
          {
            "name": "编辑",
            "action": "edit",
            "auth": "update"
          }
        ],
        "columns": [
          {
            "displayName": "检验时间",
            "name": "inspectionTime"
          },
          {
            "displayName": "检验项",
            "name": "inspectionItem"
          },
          {
            "displayName": "结果",
            "name": "result",
            "width": "100px"
          },
          {
            "displayName": "抽样数量",
            "name": "sampleQuantity"
          },
          {
            "displayName": "不良数量",
            "name": "defectQuantity"
          },
          {
            "displayName": "工单工序任务",
            "name": "workOrderStep"
          },
          {
            "displayName": "检验计划",
            "name": "inspectionPlan"
          },
          {
            "displayName": "检验员",
            "name": "inspector"
          }
        ],
        "tbar": [
          {
            "name": "新增",
            "action": "create",
            "auth": "create"
          },
          {
            "name": "删除",
            "action": "delete",
            "auth": "delete"
          }
        ]
      }
    },
    "inspection_record_search": {
      "mode": "primary",
      "name": "检验记录-搜索",
      "model": "inspection_record",
      "type": "search",
      "body": {
        "type": "search",
        "columns": [
          {
            "displayName": "检验项",
            "name": "inspectionItem"
          },
          {
            "displayName": "结果",
            "name": "result"
          },
          {
            "displayName": "检验时间",
            "name": "inspectionTime",
            "widget": "datetimerange"
          },
          {
            "displayName": "工单工序任务",
            "name": "workOrderStep"
          },
          {
            "displayName": "检验员",
            "name": "inspector"
          }
        ]
      }
    },
    "inspection_record_form": {
      "mode": "primary",
      "name": "检验记录-表单",
      "model": "inspection_record",
      "type": "form",
      "body": {
        "type": "form",
        "columns": [
          {
            "displayName": "工单工序任务",
            "name": "workOrderStep"
          },
          {
            "displayName": "检验计划",
            "name": "inspectionPlan"
          },
          {
            "displayName": "检验项",
            "name": "inspectionItem"
          },
          {
            "displayName": "结果",
            "name": "result"
          },
          {
            "displayName": "抽样数量",
            "name": "sampleQuantity"
          },
          {
            "displayName": "不良数量",
            "name": "defectQuantity"
          },
          {
            "displayName": "检验员",
            "name": "inspector"
          },
          {
            "displayName": "检验时间",
            "name": "inspectionTime"
          },
          {
            "displayName": "备注",
            "name": "remark"
          }
        ],
        "tabs": [
          {
            "header": "不良记录",
            "tbar": [
              {
                "name": "新增",
                "action": "createEr",
                "auth": "create"
              },
              {
                "name": "删除",
                "action": "deleteEr",
                "auth": "delete"
              }
            ],
            "body": {
              "type": "grid,form",
              "field": "defectRecordList",
              "columns": [
                {
                  "displayName": "不良类型",
                  "name": "defectType"
                },
                {
                  "displayName": "不良数量",
                  "name": "defectQuantity"
                },
                {
                  "displayName": "处理方式",
                  "name": "handlingMethod"
                },
                {
                  "displayName": "描述",
                  "name": "description"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
