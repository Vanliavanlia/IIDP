{
  "views": {
    "inspection_plan_grid": {
      "mode": "primary",
      "name": "检验计划-表格",
      "model": "inspection_plan",
      "type": "grid",
      "body": {
        "type": "grid",
        "buttons": [
          {
            "name": "详情",
            "action": "preview",
            "auth": "read"
          },
          {
            "name": "编辑",
            "action": "edit",
            "auth": "update"
          }
        ],
        "columns": [
          {
            "displayName": "检验项",
            "name": "inspectionItem"
          },
          {
            "displayName": "所属工序",
            "name": "processStep"
          },
          {
            "displayName": "抽样规则",
            "name": "samplingRule"
          },
          {
            "displayName": "判定标准",
            "name": "judgmentStandard"
          },
          {
            "displayName": "是否必检",
            "name": "mandatory"
          }
        ],
        "tbar": [
          {
            "name": "新增",
            "action": "create",
            "auth": "create"
          },
          {
            "name": "删除",
            "action": "delete",
            "auth": "delete"
          }
        ]
      }
    },
    "inspection_plan_search": {
      "mode": "primary",
      "name": "检验计划-搜索",
      "model": "inspection_plan",
      "type": "search",
      "body": {
        "type": "search",
        "columns": [
          {
            "displayName": "检验项",
            "name": "inspectionItem"
          },
          {
            "displayName": "所属工序",
            "name": "processStep"
          },
          {
            "displayName": "抽样规则",
            "name": "samplingRule"
          },
          {
            "displayName": "是否必检",
            "name": "mandatory"
          }
        ]
      }
    },
    "inspection_plan_form": {
      "mode": "primary",
      "name": "检验计划-表单",
      "model": "inspection_plan",
      "type": "form",
      "body": {
        "type": "form",
        "columns": [
          {
            "displayName": "检验项",
            "name": "inspectionItem",
            "required": true
          },
          {
            "displayName": "所属工序",
            "name": "processStep"
          },
          {
            "displayName": "抽样规则",
            "name": "samplingRule"
          },
          {
            "displayName": "判定标准",
            "name": "judgmentStandard"
          },
          {
            "displayName": "是否必检",
            "name": "mandatory"
          }
        ],
        "tabs": [
          {
            "header": "检验记录",
            "tbar": [
              {
                "name": "新增",
                "action": "createEr",
                "auth": "create"
              },
              {
                "name": "删除",
                "action": "deleteEr",
                "auth": "delete"
              }
            ],
            "body": {
              "type": "grid,form",
              "field": "inspectionRecordList",
              "columns": [
                {
                  "displayName": "检验项",
                  "name": "inspectionItem"
                },
                {
                  "displayName": "结果",
                  "name": "result"
                },
                {
                  "displayName": "抽样数量",
                  "name": "sampleQuantity"
                },
                {
                  "displayName": "不良数量",
                  "name": "defectQuantity"
                },
                {
                  "displayName": "检验员",
                  "name": "inspector"
                },
                {
                  "displayName": "检验时间",
                  "name": "inspectionTime"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
