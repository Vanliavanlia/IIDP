{
  "views": {
    "shift_grid": {
      "mode": "primary",
      "name": "班次-表格",
      "model": "shift",
      "type": "grid",
      "body": {
        "type": "grid",
        "buttons": [
          {
            "name": "详情",
            "action": "preview",
            "auth": "read"
          },
          {
            "name": "编辑",
            "action": "edit",
            "auth": "update"
          }
        ],
        "columns": [
          {
            "displayName": "名称",
            "name": "name"
          },
          {
            "displayName": "班次编码",
            "name": "code",
            "sortable": true,
            "width": "120px"
          },
          {
            "displayName": "开始时间",
            "name": "startTime"
          },
          {
            "displayName": "结束时间",
            "name": "endTime"
          }
        ],
        "tbar": [
          {
            "name": "新增",
            "action": "create",
            "auth": "create"
          },
          {
            "name": "删除",
            "action": "delete",
            "auth": "delete"
          }
        ]
      }
    },
    "shift_search": {
      "mode": "primary",
      "name": "班次-搜索",
      "model": "shift",
      "type": "search",
      "body": {
        "type": "search",
        "columns": [
          {
            "displayName": "名称",
            "name": "name"
          },
          {
            "displayName": "班次编码",
            "name": "code"
          },
          {
            "displayName": "开始时间",
            "name": "startTime"
          }
        ]
      }
    },
    "shift_form": {
      "mode": "primary",
      "name": "班次-表单",
      "model": "shift",
      "type": "form",
      "body": {
        "type": "form",
        "columns": [
          {
            "displayName": "班次编码",
            "name": "code"
          },
          {
            "displayName": "名称",
            "name": "name",
            "required": true
          },
          {
            "displayName": "开始时间",
            "name": "startTime"
          },
          {
            "displayName": "结束时间",
            "name": "endTime"
          }
        ],
        "tabs": [
          {
            "header": "报工记录",
            "tbar": [
              {
                "name": "新增",
                "action": "createEr",
                "auth": "create"
              },
              {
                "name": "删除",
                "action": "deleteEr",
                "auth": "delete"
              }
            ],
            "body": {
              "type": "grid,form",
              "field": "productionReportList",
              "columns": [
                {
                  "displayName": "工单工序任务",
                  "name": "workOrderStep"
                },
                {
                  "displayName": "报工数量",
                  "name": "reportQuantity"
                },
                {
                  "displayName": "合格数量",
                  "name": "qualifiedQuantity"
                },
                {
                  "displayName": "不良数量",
                  "name": "defectQuantity"
                },
                {
                  "displayName": "操作员",
                  "name": "operator"
                },
                {
                  "displayName": "报工时间",
                  "name": "reportTime"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
