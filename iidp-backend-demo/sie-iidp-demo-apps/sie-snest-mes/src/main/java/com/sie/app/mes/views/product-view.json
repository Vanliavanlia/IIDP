{
  "views": {
    "product_grid": {
      "mode": "primary",
      "name": "产品-表格",
      "model": "product",
      "type": "grid",
      "body": {
        "type": "grid",
        "buttons": [
          {
            "name": "详情",
            "action": "preview",
            "auth": "read"
          },
          {
            "name": "编辑",
            "action": "edit",
            "auth": "update"
          }
        ],
        "columns": [
          {
            "displayName": "名称",
            "name": "name"
          },
          {
            "displayName": "产品编码",
            "name": "code",
            "sortable": true,
            "width": "100px"
          },
          {
            "displayName": "规格描述",
            "name": "specDescription"
          },
          {
            "displayName": "容量（升）",
            "name": "capacity"
          },
          {
            "displayName": "主体材质",
            "name": "mainMaterial"
          },
          {
            "displayName": "状态",
            "name": "status"
          }
        ],
        "tbar": [
          {
            "name": "新增",
            "action": "create",
            "auth": "create"
          },
          {
            "name": "删除",
            "action": "delete",
            "auth": "delete"
          }
        ]
      }
    },
    "product_search": {
      "mode": "primary",
      "name": "产品-搜索",
      "model": "product",
      "type": "search",
      "body": {
        "type": "search",
        "columns": [
          {
            "displayName": "名称",
            "name": "name"
          },
          {
            "displayName": "产品编码",
            "name": "code"
          },
          {
            "displayName": "状态",
            "name": "status"
          }
        ]
      }
    },
    "product_form": {
      "mode": "primary",
      "name": "产品-表单",
      "model": "product",
      "type": "form",
      "body": {
        "type": "form",
        "columns": [
          {
            "displayName": "产品编码",
            "name": "code"
          },
          {
            "displayName": "名称",
            "name": "name",
            "required": true
          },
          {
            "displayName": "规格描述",
            "name": "specDescription"
          },
          {
            "displayName": "容量（升）",
            "name": "capacity"
          },
          {
            "displayName": "主体材质",
            "name": "mainMaterial"
          },
          {
            "displayName": "状态",
            "name": "status"
          }
        ],
        "tabs": [
          {
            "header": "产品BOM",
            "tbar": [
              {
                "name": "新增",
                "action": "createEr",
                "auth": "create"
              },
              {
                "name": "删除",
                "action": "deleteEr",
                "auth": "delete"
              }
            ],
            "body": {
              "type": "grid,form",
              "field": "productBomList",
              "columns": [
                {
                  "displayName": "子物料",
                  "name": "material"
                },
                {
                  "displayName": "用量",
                  "name": "amount"
                },
                {
                  "displayName": "单位",
                  "name": "unit"
                },
                {
                  "displayName": "BOM版本",
                  "name": "version"
                }
              ]
            }
          },
          {
            "header": "工艺路线",
            "tbar": [
              {
                "name": "新增",
                "action": "createEr",
                "auth": "create"
              },
              {
                "name": "删除",
                "action": "deleteEr",
                "auth": "delete"
              }
            ],
            "body": {
              "type": "grid,form",
              "field": "processList",
              "columns": [
                {
                  "displayName": "工艺编码",
                  "name": "code"
                },
                {
                  "displayName": "版本",
                  "name": "version"
                },
                {
                  "displayName": "状态",
                  "name": "status"
                },
                {
                  "displayName": "生效日期",
                  "name": "effectiveDate"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
