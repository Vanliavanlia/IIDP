{
  "views": {
    "process_grid": {
      "mode": "primary",
      "name": "工艺路线-表格",
      "model": "process",
      "type": "grid",
      "body": {
        "type": "grid",
        "buttons": [
          {
            "name": "详情",
            "action": "preview",
            "auth": "read"
          },
          {
            "name": "编辑",
            "action": "edit",
            "auth": "update"
          }
        ],
        "columns": [
          {
            "displayName": "工艺编码",
            "name": "code",
            "sortable": true,
            "width": "120px"
          },
          {
            "displayName": "版本",
            "name": "version"
          },
          {
            "displayName": "产品",
            "name": "product"
          },
          {
            "displayName": "状态",
            "name": "status"
          },
          {
            "displayName": "生效日期",
            "name": "effectiveDate"
          }
        ],
        "tbar": [
          {
            "name": "新增",
            "action": "create",
            "auth": "create"
          },
          {
            "name": "删除",
            "action": "delete",
            "auth": "delete"
          }
        ]
      }
    },
    "process_search": {
      "mode": "primary",
      "name": "工艺路线-搜索",
      "model": "process",
      "type": "search",
      "body": {
        "type": "search",
        "columns": [
          {
            "displayName": "工艺编码",
            "name": "code"
          },
          {
            "displayName": "版本",
            "name": "version"
          },
          {
            "displayName": "产品",
            "name": "product"
          },
          {
            "displayName": "状态",
            "name": "status"
          },
          {
            "displayName": "生效日期",
            "name": "effectiveDate",
            "widget": "daterange"
          }
        ]
      }
    },
    "process_form": {
      "mode": "primary",
      "name": "工艺路线-表单",
      "model": "process",
      "type": "form",
      "body": {
        "type": "form",
        "columns": [
          {
            "displayName": "工艺编码",
            "name": "code"
          },
          {
            "displayName": "版本",
            "name": "version",
            "required": true
          },
          {
            "displayName": "产品",
            "name": "product"
          },
          {
            "displayName": "状态",
            "name": "status"
          },
          {
            "displayName": "生效日期",
            "name": "effectiveDate"
          }
        ],
        "tabs": [
          {
            "header": "工序",
            "tbar": [
              {
                "name": "新增",
                "action": "createEr",
                "auth": "create"
              },
              {
                "name": "删除",
                "action": "deleteEr",
                "auth": "delete"
              }
            ],
            "body": {
              "type": "grid,form",
              "field": "processStepList",
              "columns": [
                {
                  "displayName": "工序序号",
                  "name": "sequence"
                },
                {
                  "displayName": "名称",
                  "name": "name"
                },
                {
                  "displayName": "工序类型",
                  "name": "stepType"
                },
                {
                  "displayName": "标准工时",
                  "name": "standardHours"
                },
                {
                  "displayName": "是否关键工序",
                  "name": "keyStep"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
