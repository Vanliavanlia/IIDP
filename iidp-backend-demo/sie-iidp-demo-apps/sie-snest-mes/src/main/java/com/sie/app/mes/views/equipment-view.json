{
  "views": {
    "equipment_grid": {
      "mode": "primary",
      "name": "设备-表格",
      "model": "equipment",
      "type": "grid",
      "body": {
        "type": "grid",
        "buttons": [
          {
            "name": "详情",
            "action": "preview",
